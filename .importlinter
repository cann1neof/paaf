# SPDX-License-Identifier: Apache-2.0
#
# Import-linter contracts (FOUND-04). These turn the architectural boundaries the
# whole framework rests on into BUILD FAILURES, not intentions. A forbidden import
# that erodes swappability turns CI red instead of rotting silently.
#
# Three contracts are declared over the five framework packages (exact names live in
# the `name =` fields below; they are intentionally NOT repeated here so each name is
# grep-unique in this file):
#   1. independence  — paaf_voice and paaf_llm may not import each other (in either
#      direction, even indirectly). Keeps the two swappable.
#   2. langchain confinement — no framework package may import the agent framework or
#      any of its provider bindings. PHASE 3 added the ONE allowed edge as an
#      ignore_imports whitelist naming exactly the adapter subpackage `paaf_llm._engine`
#      (see that contract below). Two notes on why the whitelist is spelled out longhand
#      rather than as the shorthand `paaf_llm._engine.* -> langchain*` this comment
#      originally sketched:
#        - import-linter wildcards replace a WHOLE module segment, so `langchain*` is a
#          validation error; each forbidden module is named in full instead.
#        - `paaf_llm._engine.**` matches only the STRICT DESCENDANTS of the adapter, so
#          `paaf_llm._engine` itself (the package `__init__`, where the adapter's own
#          imports live) is listed separately. Omitting it would leave the real adapter
#          red.
#      `unmatched_ignore_imports_alerting = warn` because the whitelist is a guard laid
#      down AHEAD of the adapter: until the adapter actually imports langchain, every
#      whitelisted edge is unmatched, and the default (`error`) would fail the contract
#      on its own exception list. `warn` keeps stale entries visible without that.
#   3. no network client — no framework package may carry an outbound HTTP/socket
#      client. Supports TRACE-05/PRIV-02 architecturally: nothing in the trace store
#      (or anywhere in the framework graph) can phone home.
#
# include_external_packages = True is required because the forbidden contracts name
# external modules (langchain*, httpx, ...) that must be resolvable in the graph.
#
# In Phase 2 all three contracts pass (green) against the real workspace because no
# package imports a forbidden module yet. The paired negative controls that PROVE
# each contract goes red on a deliberate violation live in tests/negcontrol/ (a
# check that cannot fail is not a check — Phase-1's twice-caught lesson).

[importlinter]
include_external_packages = True
root_packages =
    paaf_core
    paaf_trace
    paaf_llm
    paaf_voice
    paaf_session

[importlinter:contract:independence]
name = voice-and-llm-are-independent
type = independence
modules =
    paaf_voice
    paaf_llm

[importlinter:contract:langchain]
name = langchain-confined-to-adapter
type = forbidden
source_modules =
    paaf_core
    paaf_trace
    paaf_llm
    paaf_voice
    paaf_session
forbidden_modules =
    langchain
    langgraph
    langchain_core
    langchain_mcp_adapters
    langchain_ollama
    langchain_anthropic
    langchain_openai
# The ONE permitted edge: the paaf_llm._engine adapter subpackage, and nothing else.
# `paaf_llm._engine` (the package itself) and `paaf_llm._engine.**` (its submodules) are
# the only importers named — no other module in the framework gets a carve-out.
ignore_imports =
    paaf_llm._engine -> langchain
    paaf_llm._engine -> langgraph
    paaf_llm._engine -> langchain_core
    paaf_llm._engine -> langchain_mcp_adapters
    paaf_llm._engine -> langchain_ollama
    paaf_llm._engine -> langchain_anthropic
    paaf_llm._engine -> langchain_openai
    paaf_llm._engine.** -> langchain
    paaf_llm._engine.** -> langgraph
    paaf_llm._engine.** -> langchain_core
    paaf_llm._engine.** -> langchain_mcp_adapters
    paaf_llm._engine.** -> langchain_ollama
    paaf_llm._engine.** -> langchain_anthropic
    paaf_llm._engine.** -> langchain_openai
unmatched_ignore_imports_alerting = warn

[importlinter:contract:no-network]
name = no-network-client-in-framework
type = forbidden
source_modules =
    paaf_core
    paaf_trace
    paaf_llm
    paaf_voice
    paaf_session
forbidden_modules =
    httpx
    requests
    aiohttp
    socket
