  "cards": [
    {
      "dot": "cyan",
      "title": "Public LLM contract",
      "items": [
        "Value objects: Message, Usage, ToolSpec, ToolCall, HandoffRequest, TurnResult, MeshSignal",
        "Protocols: ChatAdapter, ToolCallingChatAdapter, MeshSignalSink",
        "Failures: AdapterError family, AllProvidersFailed, EngineError, UndeclaredPeer"
      ]
    },
    {
      "dot": "violet",
      "title": "Turn semantics",
      "items": [
        "Each leg gets a fresh [system, history, user] message list",
        "Handoffs follow declared peer tools; fallback follows the awake agent's ordered provider chain",
        "Only time-to-first-token can trigger fallback; a started reply commits to that provider"
      ]
    },
    {
      "dot": "rose",
      "title": "Trust and control",
      "items": [
        "Secret values stay outside YAML and resolve by api_key_ref at adapter bind time",
        "Endpoint classification is lexical/numeric and performs no DNS lookup",
        "Observer powers and hop limits are enforced by tool capability removal"
      ]
    },
    {
      "dot": "emerald",
      "title": "Persistence model",
      "items": [
        "Config writes use file lock + optimistic revision + temp/fsync/atomic rename",
        "Trace producers use non-blocking put_nowait into one bounded writer queue",
        "SQLite tables: runs, tool_calls, turn_legs, handoffs; mesh correlation uses turn_id"
      ]
    },
    {
      "dot": "amber",
      "title": "Package dependency direction",
      "items": [
        "paaf-llm depends on paaf-core and paaf-trace; the framework is an optional engine extra",
        "paaf-trace depends on paaf-core and aiosqlite; core never depends back upward",
        "paaf-session and paaf-voice currently declare no internal or runtime dependencies"
      ]
    }
  ]
